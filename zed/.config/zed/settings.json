// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "base_keymap": "VSCode",
  "vim_mode": true,
  "relative_line_numbers": true,
  "buffer_font_family": "MonoLisa",
  "buffer_font_size": 15,
  "ui_font_size": 15,
  "ui_font_family": "MonoLisa",
  "theme": {
    "light": "Zed Legacy: Solarized Light",
    "dark": "One Dark"
  },
  "icon_theme": "Material Icon Theme",
  "autosave": "on_focus_change",
  "wrap_guides": [72, 80, 120],
  "soft_wrap": "editor_width",
  "sticky_scroll": {
    "enabled": true,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "outline_panel": {
    "dock": "right"
  },
  "features": {
    "edit_prediction_provider": "copilot"
  },
  "edit_predictions": {
    "mode": "subtle",
    "enabled_in_assistant": false
  },
  "assistant": {
    "default_profile": "ask",
    "dock": "right",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-3-7-sonnet"
    },
    "version": "2"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "file_types": {
    "Markdown": ["*.qmd"]
  },
  "file_finder": {
    "modal_width": "medium"
  },
  "languages": {
    "Python": {
      // Ruff applies its fixes and sorts imports on each manual format
      // https://docs.astral.sh/ruff/editors/setup/#zed
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true,
      },
      // Servers left out of this list stay off. Zed prefers the project's
      // .venv/bin/ty, then ty on PATH. For basedpyright in one project, set
      // ["basedpyright", "ruff"] in its .zed/settings.json.
      "language_servers": ["ty", "ruff"],
      "inlay_hints": { "enabled": true },
      "semantic_tokens": "combined",
    },
  },
  "lsp": {
    "ty": {
      "settings": {
        // openFilesOnly leaves stale diagnostics in Zed (astral-sh/ty#1622)
        "diagnosticMode": "workspace",
        "inlayHints": { "variableTypes": true, "callArgumentNames": false },
        "completions": { "autoImport": true },
      },
      "initialization_options": {
        // Resolve PEP 723 inline script dependencies through uv
        "experimental": { "useUv": "scripts" },
      },
    },
    "basedpyright": {
      "settings": {
        // Zed injects "standard" unless this is set
        "basedpyright.analysis": { "typeCheckingMode": "recommended" },
      },
    },
  },
}
