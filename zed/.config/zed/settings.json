// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  // Appearance
  "theme": {
    "light": "Zed Legacy: Solarized Light",
    "dark": "One Dark",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "ui_font_family": "Lilex",
  "buffer_font_family": "MonoLisaCode",
  "buffer_font_size": 14,
  "colorize_brackets": true,
  "scrollbar": {
    "show": "never",
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "title_bar": {
    "show_menus": true,
    "show_branch_status_icon": true,
  },

  // Editing
  "base_keymap": "VSCode",
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "autosave": "on_focus_change",
  "wrap_guides": [72, 80, 100, 120],
  "soft_wrap": "editor_width",
  "sticky_scroll": {
    "enabled": true,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "completion_menu_item_kind": "symbol",

  // Workspace
  "use_system_window_tabs": true,
  "default_open_behavior": "new_window",
  "diff_view_style": "unified",
  "session": {
    "trust_all_worktrees": true,
  },
  "project_panel": {
    "dock": "left",
  },
  "which_key": {
    "enabled": true,
  },

  // Terminal
  "terminal": {
    "cursor_shape": "bar",
    "font_family": "BerkeleyMono Nerd Font Mono",
    "font_size": 15,
  },

  // AI
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "show_turn_stats": true,
    "play_sound_when_agent_done": "when_hidden",
    "default_profile": "ask",
    "commit_message_model": { "provider": "google", "model": "auto" },
    "inline_assistant_model": {
      "provider": "google",
      "model": "auto",
    },
  },
  "agent_servers": {
    "antigravity-acp": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "fast-mode": false,
        "reasoning_effort": "high",
      },
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "model": "opus-5.5",
        "mode": "default",
        "effort": "high",
      },
      "type": "registry",
    },
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "none",
  },

  // Languages
  "file_types": {
    "Markdown": ["*.qmd"],
    "R": [".Rprofile", ".Rhistory"],
  },
  "languages": {
    "Python": {
      // Ruff applies its fixes and sorts imports on each manual format
      // https://docs.astral.sh/ruff/editors/setup/#zed
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true,
      },
      // Servers left out of this list stay off. Zed prefers the project's
      // .venv/bin/ty, then ty on PATH. For basedpyright in one project, set
      // ["basedpyright", "ruff"] in its .zed/settings.json.
      "language_servers": ["ty", "ruff"],
      "inlay_hints": { "enabled": true },
      "semantic_tokens": "combined",
    },
    "R": {
      "language_servers": ["air", "r_language_server"],
      "use_on_type_format": false,
    },
  },
  "lsp": {
    "ty": {
      "settings": {
        // openFilesOnly leaves stale diagnostics in Zed (astral-sh/ty#1622)
        "diagnosticMode": "workspace",
        "inlayHints": { "variableTypes": true, "callArgumentNames": false },
        "completions": { "autoImport": true },
      },
      "initialization_options": {
        // Resolve PEP 723 inline script dependencies through uv
        "experimental": { "useUv": "scripts" },
      },
    },
    "basedpyright": {
      "settings": {
        // Zed injects "standard" unless this is set
        "basedpyright.analysis": { "typeCheckingMode": "recommended" },
      },
    },
  },

  // Privacy
  "redact_private_values": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
