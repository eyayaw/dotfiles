// Static tasks configuration.
[
  {
    "label": "Run R File",
    "command": "Rscript --vanilla",
    "args": ["$ZED_FILE"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Run R Selection/Line",
    "command": "Rscript --vanilla",
    "args": ["-e", "$ZED_SELECTED_TEXT"],
    "use_new_terminal": false
  },
  {
    "label": "Start IPython REPL",
    "command": "source \"$ZED_WORKTREE_ROOT/.venv/bin/activate\" || source \"$ZED_WORKTREE_ROOT/venv/bin/activate\"; ipython",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "tags": ["python-interactive"]
  },
  {
    "label": "Start R Console",
    "command": "R --no-save --no-restore",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "tags": ["r-interactive"]
  }
]
