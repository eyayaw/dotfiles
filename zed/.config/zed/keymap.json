// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      // "j k": ["workspace::SendKeystrokes", "escape"]
    }
  },
  // Zed's Python tasks use the interpreter of the selected toolchain
  {
    "context": "Editor && mode == full && extension == py",
    "bindings": {
      "cmd-enter": ["task::Spawn", { "task_name": "execute selection" }],
      "cmd-shift-s": ["task::Spawn", { "task_name": "run '$ZED_FILE'" }]
    }
  },
  {
    "context": "Editor && mode == full && (extension == R || extension == r)",
    "bindings": {
      "cmd-enter": ["task::Spawn", { "task_name": "Run R Selection/Line" }],
      "cmd-shift-s": ["task::Spawn", { "task_name": "Run R File" }]
    }
  }
]
