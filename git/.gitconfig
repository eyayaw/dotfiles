[user]
	name = Eyayaw Beze
	email = eyayaw@tutanota.com

[core]
	excludesfile = ~/.gitignore
	autocrlf = input
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true
	line-numbers = true

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	followTags = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = histogram

[rerere]
	enabled = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# A config-based hook (Git 2.54) scans the staged diff for secrets in every repository,
# with no per-clone install. The PATH covers GUI clients, which start git with a short one.
[hook "gitleaks-pre-commit"]
	event = pre-commit
	command = PATH=\"$HOME/.local/bin:/opt/homebrew/bin:$PATH\" prek hook-impl -q --hook-type pre-commit --config \"$HOME/.config/prek/global-hooks.toml\" --
